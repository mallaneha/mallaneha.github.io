---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Explainers from "../../components/Explainers.astro";
import { site } from "../../data/site";
import { getWriting, formatDate } from "../../lib/content";

export async function getStaticPaths() {
  const writing = await getWriting();
  return writing.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base title={entry.data.title} description={entry.data.description}>
  <p>
    <a href="/writing/">← Writing</a>
  </p>
  <div class="read-progress" data-read-progress aria-hidden="true"></div>
  <article>
    <header>
      <h1>{entry.data.title}</h1>
      <p class="muted">
        <time datetime={entry.data.date.toISOString().slice(0, 10)}>
          {formatDate(entry.data.date)}
        </time>
        {entry.data.type === "note" && " · Note"}
        {entry.data.draft && " · Draft"}
      </p>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
  <Explainers />
  <p class="muted back">
    <a href="/">{site.name}</a>
  </p>
</Base>

<style>
  /* Reading progress (src/scripts/effects.ts sets --progress): a thin bar along the top edge,
     hidden at the very top of the post, filling as you read. */
  .read-progress {
    position: fixed;
    inset: 0 0 auto;
    z-index: 10;
    height: 2px;
    background: var(--color-text);
    transform-origin: left;
    transform: scaleX(var(--progress, 0));
    opacity: 0;
    transition: opacity var(--transition);
    pointer-events: none;
  }
  .read-progress.shown {
    opacity: 1;
  }
  @media print {
    .read-progress {
      display: none;
    }
  }
  header {
    margin: var(--space-8) 0;
  }
  .prose :global(h2) {
    margin: var(--space-8) 0 var(--space-3);
  }
  .prose :global(ul:not(.xp *)),
  .prose :global(ol:not(.xp *)) {
    padding-left: var(--space-6);
  }
  .prose :global(ol:not(.xp *)) {
    font-variant-numeric: tabular-nums;
  }
  .prose :global(li:not(.xp *))::marker {
    color: var(--color-muted);
  }
  .prose :global(hr) {
    border: 0;
    border-top: 1px solid var(--color-border);
    margin: var(--space-8) 0;
  }
  /* Markdown tables: a wide one scrolls inside itself, never the page. Lists and tables inside a post widget
     (.xp) are skipped here: Explainers.astro styles those, and these would otherwise outrank it. */
  .prose :global(table:not(.xp *)) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: var(--text-sm);
    margin: 0 0 var(--space-4);
  }
  .prose :global(th:not(.xp *)),
  .prose :global(td:not(.xp *)) {
    padding: var(--space-2) var(--space-3);
    text-align: left;
    border-bottom: 1px solid var(--color-border);
    font-variant-numeric: tabular-nums;
  }
  .prose :global(th:not(.xp *)) {
    font-weight: var(--weight-medium);
    color: var(--color-text);
  }
  .prose :global(td:not(.xp *)) {
    color: inherit;
  }
  .prose :global(th[align="right"]:not(.xp *)),
  .prose :global(td[align="right"]:not(.xp *)) {
    text-align: right;
  }
  .prose :global(th[align="center"]:not(.xp *)),
  .prose :global(td[align="center"]:not(.xp *)) {
    text-align: center;
  }
  .back {
    margin-top: var(--space-12);
  }
</style>
