---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Explainers from "../../components/Explainers.astro";
import { site } from "../../data/site";
import { getWriting, formatDate } from "../../lib/content";

export async function getStaticPaths() {
  const writing = await getWriting();
  return writing.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base title={entry.data.title} description={entry.data.description}>
  <p>
    <a href="/writing/">← Writing</a>
  </p>
  <article>
    <header>
      <h1>{entry.data.title}</h1>
      <p class="muted">
        <time datetime={entry.data.date.toISOString().slice(0, 10)}>
          {formatDate(entry.data.date)}
        </time>
        {entry.data.type === "note" && " · Note"}
        {entry.data.draft && " · Draft"}
      </p>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
  <Explainers />
  <p class="muted back">
    <a href="/">{site.name}</a>
  </p>
</Base>

<style>
  header {
    margin: var(--space-8) 0;
  }
  .prose :global(h2) {
    margin: var(--space-8) 0 var(--space-3);
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: var(--space-6);
  }
  .prose :global(ol) {
    font-variant-numeric: tabular-nums;
  }
  .prose :global(li)::marker {
    color: var(--color-muted);
  }
  .prose :global(hr) {
    border: 0;
    border-top: 1px solid var(--color-border);
    margin: var(--space-8) 0;
  }
  /* Markdown tables: a wide one scrolls inside itself, never the page. */
  .prose :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: var(--text-sm);
    margin: 0 0 var(--space-4);
  }
  .prose :global(th),
  .prose :global(td) {
    padding: var(--space-2) var(--space-3);
    text-align: left;
    border-bottom: 1px solid var(--color-border);
    font-variant-numeric: tabular-nums;
  }
  .prose :global(th) {
    font-weight: var(--weight-medium);
    color: var(--color-text);
  }
  .prose :global(td) {
    color: inherit;
  }
  .prose :global(th[align="right"]),
  .prose :global(td[align="right"]) {
    text-align: right;
  }
  .prose :global(th[align="center"]),
  .prose :global(td[align="center"]) {
    text-align: center;
  }
  .back {
    margin-top: var(--space-12);
  }
</style>
