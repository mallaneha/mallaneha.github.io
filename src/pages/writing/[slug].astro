---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { site } from "../../data/site";
import { getWriting, formatDate } from "../../lib/content";

export async function getStaticPaths() {
  const writing = await getWriting();
  return writing.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base title={entry.data.title} description={entry.data.description}>
  <p>
    <a href="/writing/">← Writing</a>
  </p>
  <article>
    <header>
      <h1>{entry.data.title}</h1>
      <p class="muted">
        <time datetime={entry.data.date.toISOString().slice(0, 10)}>
          {formatDate(entry.data.date)}
        </time>
        {entry.data.type === "note" && " · Note"}
        {entry.data.draft && " · Draft"}
      </p>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
  <p class="muted back">
    <a href="/">{site.name}</a>
  </p>
</Base>

<style>
  header {
    margin: var(--space-8) 0;
  }
  .prose :global(h2) {
    margin: var(--space-8) 0 var(--space-3);
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: var(--space-6);
  }
  .back {
    margin-top: var(--space-12);
  }
</style>
