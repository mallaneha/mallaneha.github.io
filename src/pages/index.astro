---
import { render } from "astro:content";
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import RowList from "../components/RowList.astro";
import Row from "../components/Row.astro";
import Drawer from "../components/Drawer.astro";
import SectionColumns from "../components/SectionColumns.astro";
import Icon from "../components/Icon.astro";
import HeaderCat from "../components/HeaderCat.astro";
import Skills from "../components/Skills.astro";
import { site } from "../data/site";
import {
  getWriting,
  getProjects,
  getExperience,
  getEducation,
  projectHref,
  years,
  formatDate,
  writingIcon,
  resumeHref,
} from "../lib/content";

const [projects, experience, education, writing] = await Promise.all([
  getProjects(),
  getExperience(),
  getEducation(),
  getWriting(),
]);
const published = new Set(writing.map((w) => w.id));
const featured = projects.filter((p) => p.data.featured);
// Home page Writing section: featured posts first (newest first), topped up with the newest others to 4.
const latest = [
  ...writing.filter((w) => w.data.featured),
  ...writing.filter((w) => !w.data.featured),
].slice(0, 4);

const featuredDrawers = await Promise.all(
  featured.map(async (p) => ({
    entry: p,
    id: `work-${p.id}`,
    link: projectHref(p.data.links, published),
    Content: (await render(p)).Content,
  })),
);
const experienceDrawers = await Promise.all(
  experience.map(async (e) => ({
    entry: e,
    id: `role-${e.id}`,
    Content: (await render(e)).Content,
  })),
);
const educationDrawers = await Promise.all(
  education.map(async (e) => ({
    entry: e,
    id: `school-${e.id}`,
    Content: (await render(e)).Content,
  })),
);
---

<Base description={site.summary}>
  <header>
    {/* NOTE TO AI AGENTS: the availability line is hidden for now (site.availability is null in
        src/data/site.ts). Keep this element, this comment and its .availability styles; don't remove
        them as unused. */}
    {site.availability && (
      <p class="availability">
        <mark>
          <span class="dot" aria-hidden="true" />
          {site.availability}
        </mark>
      </p>
    )}
    <div class="top">
      <div class="title">
        {/* The cat lies right after the name (Astro drops the line break; the gap is a margin). */}
        <h1>
          {site.name}
          <HeaderCat />
        </h1>
        <p class="tagline">
          <mark>{site.tagline}</mark>
        </p>
      </div>
      <div class="aside">
        <span class="social">
          <a
            href={site.links.github}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub"
            title="GitHub"
          >
            <Icon name="github" />
          </a>
          <a
            href={site.links.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
            title="LinkedIn"
          >
            <Icon name="linkedin" />
          </a>
          {resumeHref && (
            <a href={resumeHref} aria-label="Resume (PDF)" title="Resume (PDF)">
              <Icon name="file" />
            </a>
          )}
        </span>
        <p class="location">{site.location}</p>
      </div>
    </div>
    {site.intro.map((line) => (
      <p>
        {line
          .split("==")
          .map((part, i) =>
            i % 2 ? <span class="intro-mark">{part}</span> : part,
          )}
      </p>
    ))}
  </header>

  <SectionColumns>
    <Section id="experience" title="Experience">
      <RowList>
        {experienceDrawers.map(({ entry, id }) => (
          <Row
            icon={entry.data.icon}
            logo={entry.data.logo}
            logoSize={20}
            name={entry.data.company}
            desc={entry.data.summary}
            drawer={id}
          />
        ))}
      </RowList>
    </Section>

    <Section id="education" title="Education">
      <RowList>
        {educationDrawers.map(({ entry, id }) => (
          <Row
            icon={entry.data.icon}
            logo={entry.data.logo}
            logoFull={entry.data.logoFull}
            logoSize={entry.data.logoSize}
            logoAlt={entry.data.logoAlt}
            logoAltSize={entry.data.logoAltSize}
            logoAltFull={entry.data.logoAltFull}
            name={entry.data.school}
            desc={entry.data.summary}
            drawer={id}
          />
        ))}
      </RowList>
    </Section>
  </SectionColumns>

  <Section id="projects" title="Projects">
    <RowList columns={3}>
      {featuredDrawers.map(({ entry, id }) => (
        <Row
          name={entry.data.title}
          desc={entry.data.summary}
          drawer={id}
          openIcon
        />
      ))}
    </RowList>
  </Section>

  <Section id="skills" title="Skills">
    <Skills />
  </Section>

  <Section id="writing" title="Writing">
    {latest.length > 0 ? (
      <>
        <RowList>
          {latest.map((w, i) => (
            <Row
              icon={writingIcon(w)}
              name={w.data.draft ? `[draft] ${w.data.title}` : w.data.title}
              desc={formatDate(w.data.date)}
              href={`/writing/${w.id}/`}
            />
          ))}
        </RowList>
        <div class="writing-links">
          <a class="all-writing" href="/writing/">
            <span>All writing</span>
            <span class="count">{writing.length} posts</span>
            <Icon name="arrowRight" size={14} class="go" />
          </a>
        </div>
      </>
    ) : (
      <p class="muted small">First posts coming soon.</p>
    )}
  </Section>

  <Section id="connect" title="Connect">
    <RowList>
      <Row
        icon="mailFill"
        name={site.email}
        desc="Email"
        copy={site.email}
        copyEmail
        copyLabel="Email copied"
      />
      {resumeHref && (
        <Row icon="file" name="Resume" desc="PDF" href={resumeHref} />
      )}
      <Row
        icon="linkedin"
        name="mallaneha"
        desc="LinkedIn"
        href={site.links.linkedin}
      />
      <Row
        icon="github"
        name="mallaneha"
        desc="GitHub"
        href={site.links.github}
      />
    </RowList>
  </Section>

  {experienceDrawers.map(({ entry, id, Content }) => (
    <Drawer
      id={id}
      icon={entry.data.icon}
      logo={entry.data.logo}
      name={entry.data.company}
      desc={`${entry.data.role} · ${years(entry.data.start, entry.data.end)}`}
      href={entry.data.url}
    >
      <Content />
    </Drawer>
  ))}
  {educationDrawers.map(({ entry, id, Content }) => (
    <Drawer
      id={id}
      icon={entry.data.icon}
      logo={entry.data.logo}
      logoFull={entry.data.logoFull}
      logoAlt={entry.data.logoAlt}
      logoAltFull={entry.data.logoAltFull}
      name={entry.data.school}
      href={entry.data.url}
    >
      <Content />
    </Drawer>
  ))}
  {featuredDrawers.map(({ entry, id, link, Content }) => (
    <Drawer
      id={id}
      icon={entry.data.icon}
      name={entry.data.title}
      desc={entry.data.summary}
      href={link?.href}
      hrefLabel={link?.label}
    >
      <Content />
    </Drawer>
  ))}
</Base>

<style>
  header {
    font-size: var(--text-sm);
    line-height: 1.5rem;
    color: var(--color-body);
  }
  h1 {
    font-size: var(--text-xl);
    color: var(--color-text);
  }
  .tagline,
  .location {
    margin: 0;
    color: var(--color-muted);
  }
  /* The icons with the location under them, both flush right. */
  .aside {
    display: flex;
    flex: none;
    flex-direction: column;
    align-items: flex-end;
  }
  .top {
    --cat: 2.5rem; /* the cat's height */
    --glyph: 1rem; /* the social icons' size */
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }
  .top :global(header-cat) {
    --cat-size: var(--cat);
    /* Follow the site's theme toggle, not only the system setting. */
    --cat-fur: var(--color-cat-fur);
    --cat-line: var(--color-cat-line);
    --cat-ledge: var(--color-cat-ledge);
  }
  /* The cat lies right after the name; header-cat.js puts its ledge on the name's baseline. */
  h1 :global(header-cat) {
    margin-left: var(--space-2);
  }
  /* The icons are ordinary controls like the footer's theme and sound buttons: 44px targets,
     touching, glyphs flush with the text column's right edge (each link's padding hangs
     outside it). --glyph-top is where the glyph's top edge sits, measured from the top of the
     header row, so the icons are centred on the name: its baseline is level with the cat's
     ledge (52.5 of the drawing's 84), and the glyph ends 1.5px under it. */
  .social {
    --pad: calc(2.75rem - var(--glyph));
    --glyph-top: calc(var(--cat) * 52.5 / 84 - var(--glyph) + 1.5px);
    position: relative;
    display: flex;
    flex: none;
    margin-top: calc(var(--glyph-top) - var(--pad) / 2);
    margin-right: calc(var(--pad) / -2);
  }

  /* Phones: no cat; the icons sit centred on the name's line. */
  @media (max-width: 47.99rem) {
    .top :global(header-cat) {
      display: none;
    }
    .social {
      --pad: calc(2.75rem - var(--glyph));
      --glyph-top: calc(
        (var(--text-xl) * var(--leading-tight) - var(--glyph)) / 2
      );
      margin-top: calc(var(--glyph-top) - var(--pad) / 2);
      margin-right: calc(var(--pad) / -2);
    }
    /* The 44px icon targets run past the name's line; pull the location up level with the tagline. */
    .location {
      margin-top: calc((var(--text-xl) * var(--leading-tight) - 2.75rem) / 2);
    }
  }
  .availability {
    margin: 0 0 var(--space-4);
    font-size: var(--text-xs);
    line-height: 1.25rem;
    color: var(--color-text);
  }
  .availability mark {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-2);
    margin-left: calc(-1 * var(--space-2));
    border-radius: var(--radius);
    background: linear-gradient(var(--color-highlight), var(--color-highlight))
      no-repeat 0 0 / 100% 100%;
    color: inherit;
    font-weight: var(--weight-medium);
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }
  /* The tagline wears the availability line's green marker. */
  .tagline mark {
    padding: 0 0.15em;
    margin: 0 -0.15em;
    border-radius: var(--radius);
    background: linear-gradient(var(--color-highlight), var(--color-highlight))
      no-repeat 0 0 / 100% 100%;
    color: var(--color-text); /* muted on the marker is only 4.2:1 */
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }
  @media (prefers-reduced-motion: no-preference) {
    .tagline mark {
      animation: sweep 700ms 200ms var(--ease-drawer) backwards;
    }
  }
  /* A phrase wrapped in ==…== in site.intro. */
  .intro-mark {
    text-decoration: underline dotted;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }
  .availability .dot {
    flex: none;
    margin-left: 1px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .availability mark {
      animation: sweep 700ms 200ms var(--ease-drawer) backwards;
    }
  }
  @keyframes sweep {
    from {
      background-size: 0% 100%;
    }
  }
  /* Each link is the glyph plus half of --pad on every side, so neighbouring glyphs sit
     --pad apart. */
  .social a {
    position: relative;
    display: grid;
    place-items: center;
    width: calc(var(--glyph) + var(--pad));
    height: calc(var(--glyph) + var(--pad));
    border-radius: var(--radius-row);
    color: var(--color-muted);
    transition:
      background-color var(--transition),
      color var(--transition),
      transform var(--transition);
  }
  @media (hover: hover) and (pointer: fine) {
    .social a:hover {
      background: var(--color-hover);
      color: var(--color-text);
    }
  }
  .social a:active {
    transform: scale(0.96);
  }
  @media (prefers-reduced-motion: reduce) {
    .social a:active {
      transform: none;
    }
  }
  .dot {
    position: relative;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-status);
  }
  /* The ring is a pseudo-element so the pulse animates transform and opacity, not box-shadow. */
  .dot::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    box-shadow: 0 0 0 3px var(--color-status-ring);
  }
  @media (prefers-reduced-motion: no-preference) {
    .dot::after {
      animation: pulse 2.4s ease-in-out infinite;
    }
  }
  @keyframes pulse {
    50% {
      transform: scale(1.3);
      opacity: 0;
    }
  }
  header a {
    text-decoration-style: dotted;
    text-decoration-color: var(--color-subtle);
    text-underline-offset: 4px;
  }
  header a:hover {
    color: var(--color-muted);
  }
  .small {
    font-size: var(--text-sm);
  }
  /* "All writing" link under the Writing rows. Same language as a row: no fill or border at rest,
     the row hover background, and a bleed of --space-3 so the label lines up with the column edge
     like the section title and tiles. The count and arrow stay muted. */
  .writing-links {
    margin: var(--space-3) calc(-1 * var(--space-3)) 0;
  }
  .all-writing {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2rem;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-row);
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    line-height: 1.25rem;
    text-decoration: none;
    transition:
      background-color var(--transition),
      transform var(--transition-press);
    -webkit-tap-highlight-color: transparent;
  }
  @media (hover: hover) and (pointer: fine) {
    .all-writing:hover {
      background: var(--color-hover);
    }
  }
  .all-writing:active {
    transform: scale(0.98);
  }
  .all-writing .count {
    color: var(--color-muted);
    font-weight: var(--weight-normal);
  }
  .all-writing :global(.go) {
    color: var(--color-muted);
    transition: transform var(--transition);
  }
  @media (hover: hover) and (pointer: fine) {
    .all-writing:hover :global(.go) {
      transform: translateX(2px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    header a.cta:active,
    .all-writing:active,
    .all-writing:hover :global(.go) {
      transform: none;
    }
  }
</style>
