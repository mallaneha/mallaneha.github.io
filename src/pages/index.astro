---
import { render } from "astro:content";
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import RowList from "../components/RowList.astro";
import Row from "../components/Row.astro";
import Drawer from "../components/Drawer.astro";
import SectionColumns from "../components/SectionColumns.astro";
import Icon from "../components/Icon.astro";
import { site } from "../data/site";
import {
  getWriting,
  getProjects,
  getExperience,
  getEducation,
  projectHref,
  years,
  formatDate,
  nepaliLetter,
  resumeHref,
} from "../lib/content";

const [projects, experience, education, writing] = await Promise.all([
  getProjects(),
  getExperience(),
  getEducation(),
  getWriting(),
]);
const published = new Set(writing.map((w) => w.id));
const featured = projects.filter((p) => p.data.featured);
const latest = writing.slice(0, 3);

const featuredDrawers = await Promise.all(
  featured.map(async (p) => ({
    entry: p,
    id: `work-${p.id}`,
    link: projectHref(p.data.links, published),
    Content: (await render(p)).Content,
  })),
);
const experienceDrawers = await Promise.all(
  experience.map(async (e) => ({
    entry: e,
    id: `role-${e.id}`,
    Content: (await render(e)).Content,
  })),
);
const educationDrawers = await Promise.all(
  education.map(async (e) => ({
    entry: e,
    id: `school-${e.id}`,
    Content: (await render(e)).Content,
  })),
);
---

<Base description={site.summary} effects>
  <header>
    <div class="top">
      <h1>{site.name}</h1>
      <span class="social">
        <a
          href={site.links.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
          title="LinkedIn"
        >
          <Icon name="linkedin" />
        </a>
        <a
          href={site.links.github}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
          title="GitHub"
        >
          <Icon name="github" />
        </a>
        {resumeHref && (
          <a href={resumeHref} aria-label="Resume (PDF)" title="Resume (PDF)">
            <Icon name="file" />
          </a>
        )}
      </span>
    </div>
    <p class="tagline">{site.tagline}</p>
    {site.availability && (
      <p class="availability">
        <mark>
          <span class="dot" aria-hidden="true" />
          {site.availability}.
        </mark>
        <a href="#connect">Get in touch →</a>
      </p>
    )}
    {site.intro.map((line) => (
      <p>{line}</p>
    ))}
  </header>

  <SectionColumns>
    <Section id="experience" title="Experience">
      <RowList>
        {experienceDrawers.map(({ entry, id }) => (
          <Row
            icon={entry.data.icon}
            logo={entry.data.logo}
            logoSize={20}
            name={entry.data.company}
            desc={entry.data.summary}
            drawer={id}
          />
        ))}
      </RowList>
    </Section>

    <Section id="education" title="Education">
      <RowList>
        {educationDrawers.map(({ entry, id }) => (
          <Row
            icon={entry.data.icon}
            logo={entry.data.logo}
            logoFull={entry.data.logoFull}
            logoSize={entry.data.logoSize}
            name={entry.data.school}
            desc={entry.data.summary}
            drawer={id}
          />
        ))}
      </RowList>
    </Section>
  </SectionColumns>

  <Section id="projects" title="Projects">
    <RowList columns={3}>
      {featuredDrawers.map(({ entry, id }) => (
        <Row
          name={entry.data.title}
          desc={entry.data.summary}
          drawer={id}
          openIcon
        />
      ))}
    </RowList>
  </Section>

  <Section id="writing" title="Writing" blurb={site.writingBlurb}>
    {latest.length > 0 ? (
      <>
        <RowList>
          {latest.map((w, i) => (
            <Row
              glyph={nepaliLetter(i)}
              name={w.data.draft ? `[draft] ${w.data.title}` : w.data.title}
              desc={formatDate(w.data.date)}
              href={`/writing/${w.id}/`}
            />
          ))}
        </RowList>
        <a class="all-writing" href="/writing/">
          <span>All writing</span>
          <span class="count">{writing.length} posts</span>
          <Icon name="arrowRight" size={14} class="go" />
        </a>
      </>
    ) : (
      <p class="muted small">First posts coming soon.</p>
    )}
  </Section>

  <Section id="connect" title="Connect">
    <RowList>
      <Row
        icon="mailFill"
        name={site.email}
        desc="Email"
        copy={site.email}
        copyEmail
        copyLabel="Email copied"
      />
      {resumeHref && (
        <Row icon="file" name="Resume" desc="PDF" href={resumeHref} />
      )}
      <Row
        icon="linkedin"
        name="mallaneha"
        desc="LinkedIn"
        href={site.links.linkedin}
      />
      <Row
        icon="github"
        name="mallaneha"
        desc="GitHub"
        href={site.links.github}
      />
    </RowList>
  </Section>

  {experienceDrawers.map(({ entry, id, Content }) => (
    <Drawer
      id={id}
      icon={entry.data.icon}
      logo={entry.data.logo}
      name={entry.data.company}
      desc={`${entry.data.role} · ${years(entry.data.start, entry.data.end)}`}
      href={entry.data.url}
    >
      <Content />
    </Drawer>
  ))}
  {educationDrawers.map(({ entry, id, Content }) => (
    <Drawer
      id={id}
      icon={entry.data.icon}
      logo={entry.data.logo}
      logoFull={entry.data.logoFull}
      name={entry.data.school}
      desc={`${entry.data.degree} · ${years(entry.data.start, entry.data.end)}`}
      href={entry.data.url}
    >
      <Content />
    </Drawer>
  ))}
  {featuredDrawers.map(({ entry, id, link, Content }) => (
    <Drawer
      id={id}
      icon={entry.data.icon}
      name={entry.data.title}
      desc={entry.data.summary}
      href={link?.href}
      hrefLabel={link?.label}
    >
      <Content />
    </Drawer>
  ))}
</Base>

<style>
  header {
    font-size: var(--text-sm);
    line-height: 1.5rem;
    color: var(--color-body);
  }
  h1 {
    color: var(--color-text);
  }
  .tagline {
    margin: 0 0 var(--space-6);
    color: var(--color-muted);
  }
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }
  /* Negative margins so the icon buttons don't make the name row taller. */
  .top .social {
    margin: calc(-1 * var(--space-2)) calc(-1 * var(--space-2))
      calc(-1 * var(--space-2)) 0;
  }
  .availability {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-3);
    color: var(--color-text);
  }
  .availability mark {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-3);
    margin-left: calc(-1 * var(--space-3));
    border-radius: var(--radius);
    background: linear-gradient(var(--color-highlight), var(--color-highlight))
      no-repeat 0 0 / 100% 100%;
    color: inherit;
    font-weight: var(--weight-medium);
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }
  .availability .dot {
    flex: none;
    margin-left: 1px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .availability mark {
      animation: sweep 700ms 200ms var(--ease-drawer) backwards;
    }
  }
  @keyframes sweep {
    from {
      background-size: 0% 100%;
    }
  }
  .social {
    display: inline-flex;
    gap: var(--space-1);
  }
  .social a {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-row);
    color: var(--color-muted);
    transition:
      background-color var(--transition),
      color var(--transition);
  }
  .social a:hover {
    background: var(--color-hover);
    color: var(--color-text);
  }
  @media (pointer: coarse) {
    .social a {
      width: 2.75rem;
      height: 2.75rem;
    }
  }
  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-status);
    box-shadow: 0 0 0 3px var(--color-status-ring);
  }
  @media (prefers-reduced-motion: no-preference) {
    .dot {
      animation: pulse 2.4s ease-in-out infinite;
    }
  }
  @keyframes pulse {
    50% {
      box-shadow: 0 0 0 5px transparent;
    }
  }
  header a {
    text-decoration-style: dotted;
    text-decoration-color: var(--color-subtle);
    text-underline-offset: 4px;
  }
  header a:hover {
    color: var(--color-muted);
  }
  .small {
    font-size: var(--text-sm);
  }
  .all-writing {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-4);
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    line-height: 1.25rem;
    text-decoration: none;
    transition:
      background-color var(--transition),
      transform var(--transition);
    -webkit-tap-highlight-color: transparent;
  }
  .all-writing:hover {
    background: var(--color-surface-hover);
  }
  .all-writing:active {
    transform: scale(0.98);
  }
  .all-writing .count {
    color: var(--color-muted);
    font-weight: var(--weight-normal);
  }
  .all-writing :global(.go) {
    color: var(--color-muted);
    transition: transform var(--transition);
  }
  .all-writing:hover :global(.go) {
    transform: translateX(2px);
  }
</style>
