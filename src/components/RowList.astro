---
// A list of Rows. `columns={2}` puts them side by side (short rows such as profile links);
// `columns={3}` fits three in one line from tablet width up and stacks them on phones.
interface Props {
  columns?: 1 | 2 | 3;
}
const { columns = 1 } = Astro.props;
---

<ul class:list={{ cols: columns === 2, cols3: columns === 3 }}>
  <slot />
</ul>

<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
  }
  /* Rows bleed var(--space-3) past each side for their hover background, so the column gap is twice that. */
  .cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-1) var(--space-6);
  }
  @media (min-width: 36rem) {
    .cols3 {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-1) var(--space-6);
    }
  }
  ul + ul {
    margin-top: var(--space-1);
  }
</style>
