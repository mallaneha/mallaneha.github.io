---
import { site } from "../data/site";
import Icon from "./Icon.astro";

interface Props {
  effects?: boolean; // show the click-sound toggle (pages with click effects only)
}
const { effects = false } = Astro.props;
const year = new Date().getFullYear();
---

<footer>
  <span>
    {site.motto && <>{site.motto} · </>}© {year} · {site.location}
    <span class="time" data-local-time={site.timeZone} hidden>
      {" · "}
      <time></time>
    </span>
  </span>
  <span class="controls">
    {effects && (
      <button
        type="button"
        class="control sound"
        data-effects-toggle
        aria-pressed="true"
        aria-label="Click sounds"
      >
        <Icon name="soundOn" size={14} class="on" />
        <Icon name="soundOff" size={14} class="off" />
      </button>
    )}
    <button
      type="button"
      class="control theme"
      data-theme-toggle
      aria-label="Dark theme"
      aria-pressed="false"
    >
      <Icon name="moon" size={14} class="moon" />
      <Icon name="sun" size={14} class="sun" />
    </button>
  </span>
</footer>

<style>
  footer {
    max-width: var(--measure);
    margin: 0 auto;
    padding: 0 var(--space-4) var(--space-12);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
  .time time {
    font-variant-numeric: tabular-nums;
  }
  .controls {
    display: flex;
    margin-right: calc(-1 * var(--space-3));
  }
  .control {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    border-radius: var(--radius-row);
    background: transparent;
    color: var(--color-muted);
    cursor: pointer;
    transition:
      background-color var(--transition),
      color var(--transition);
  }
  .control:hover {
    background: var(--color-hover);
    color: var(--color-text);
  }
  .sound :global(.off),
  .sound[data-state="off"] :global(.on) {
    display: none;
  }
  .sound[data-state="off"] :global(.off) {
    display: block;
  }
  /* Show the theme you'd switch to: moon in light, sun in dark. */
  .theme :global(.sun),
  .theme[data-state="dark"] :global(.moon) {
    display: none;
  }
  .theme[data-state="dark"] :global(.sun) {
    display: block;
  }
</style>
