---
// Skills: three topic tiles (a tab list) over one card of competency chips. Hover (mouse), tap or
// focus a tile to show its chips; the first topic shows by default and without JS. Inspired by
// Framer's "Toolstack Gallery" (the focused item grows, the others blur back), but the card sits
// below the row so it never covers the intro. Behavior: src/scripts/skills.ts (effects.ts loads it when this is on the page). Data: src/data/skills.ts.
import Icon from "./Icon.astro";
import { skills } from "../data/skills";
---

<div class="skills" data-skills>
  <div class="tabs" role="tablist" aria-label="Skill areas">
    {skills.map((s, i) => (
      <button
        type="button"
        role="tab"
        class="tab"
        id={`skill-tab-${s.id}`}
        aria-controls={`skill-panel-${s.id}`}
        aria-selected={i === 0 ? "true" : "false"}
        tabindex={i === 0 ? 0 : -1}
      >
        <span class="tile">
          <Icon name={s.icon} />
        </span>
        <span class="name">{s.name}</span>
        <span class="verb">{s.verb}</span>
      </button>
    ))}
  </div>
  <div class="panels">
    {skills.map((s, i) => (
      <div
        role="tabpanel"
        class="panel"
        id={`skill-panel-${s.id}`}
        aria-labelledby={`skill-tab-${s.id}`}
        data-active={i === 0 ? "" : undefined}
      >
        <ul class="chips">
          {s.items.map((item, j) => (
            <li style={`--i: ${j}`}>{item}</li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</div>

<style>
  /* Motion: every change is a transition (not keyframes), so fast hovering across tiles retargets
     from wherever things are instead of restarting. Only opacity, transform and filter animate. */
  .tabs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-2);
    /* Bleed by the tiles' padding, like Row, so icons and names sit on the column edge. */
    margin: 0 calc(-1 * var(--space-2));
  }

  .tab {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-1);
    min-width: 0;
    padding: var(--space-2);
    border: 0;
    border-radius: calc(var(--radius-tile) + var(--space-2));
    background: transparent;
    color: var(--color-muted);
    font: inherit;
    font-size: var(--text-sm);
    line-height: 1.25rem;
    text-align: left;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition:
      background-color var(--duration-state) var(--ease-out),
      color var(--duration-state) var(--ease-out),
      opacity var(--duration-state) var(--ease-out),
      filter var(--duration-state) var(--ease-out),
      transform var(--transition-press);
  }
  .tab:focus-visible {
    border-radius: calc(var(--radius-tile) + var(--space-2));
  }
  .tab:active {
    transform: scale(0.97);
  }
  .tab[aria-selected="true"] {
    background: var(--color-surface);
    color: var(--color-text);
  }

  .tile {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    margin-bottom: var(--space-1);
    border-radius: var(--radius-tile);
    background: var(--color-surface);
    transition:
      background-color var(--duration-state) var(--ease-out),
      box-shadow var(--duration-state) var(--ease-out);
  }
  .tab[aria-selected="true"] .tile {
    background: var(--color-raised);
    box-shadow: var(--shadow-raised);
  }

  .name {
    font-weight: var(--weight-medium);
    overflow-wrap: anywhere;
    transform-origin: left center;
    transition: transform var(--duration-state) var(--ease-out);
  }
  /* The active name grows in a little. */
  .tab[aria-selected="true"] .name {
    transform: scale(1.04);
  }
  .verb {
    color: var(--color-muted);
  }

  /* While the mouse is over the row, the tiles that aren't active blur back. Not on touch (taps fire
     false hovers) and not for keyboard users. */
  @media (hover: hover) and (pointer: fine) {
    .tabs:hover .tab[aria-selected="false"] {
      opacity: 0.5;
      filter: blur(1.5px);
    }
    .tabs:hover .tab[aria-selected="false"]:hover {
      opacity: 1;
      filter: none;
    }
  }

  /* All panels share one grid cell, so the card is as tall as the longest topic and switching
     never moves the page. Hidden panels keep their size but leave the accessibility tree and tab
     order (visibility), after their chips have faded out. */
  .panels {
    display: grid;
    margin-top: var(--space-3);
  }
  .panel {
    grid-area: 1 / 1;
    visibility: hidden;
    transition: visibility 0s linear var(--skills-out);
  }
  .panel[data-active] {
    visibility: visible;
    transition-delay: 0s;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .chips li {
    padding: 0.125rem var(--space-2);
    border-radius: var(--radius);
    background: var(--color-surface);
    color: var(--color-body);
    font-size: var(--text-sm);
    line-height: 1.25rem;
    /* Leaving: fast, all at once. */
    opacity: 0;
    transform: translateY(4px) scale(0.97);
    transition:
      opacity var(--skills-out) var(--ease-out),
      transform var(--skills-out) var(--ease-out);
  }
  /* Entering: rise in one after another, starting once the old chips are mostly gone. */
  .panel[data-active] .chips li {
    opacity: 1;
    transform: none;
    transition-duration: var(--skills-in);
    transition-delay: calc(
      var(--skills-out) / 2 + min(var(--i), 8) * var(--skills-stagger)
    );
  }

  /* Phones: tighter tiles; the verb goes first if space runs out. */
  @media (max-width: 22.4375rem) {
    .verb {
      display: none;
    }
  }

  /* Reduced motion: no movement, no scaling, no blur. Chips still cross-fade, together. */
  @media (prefers-reduced-motion: reduce) {
    .tab:active,
    .tab[aria-selected="true"] .name {
      transform: none;
    }
    .tabs:hover .tab[aria-selected="false"] {
      filter: none;
    }
    .chips li,
    .panel[data-active] .chips li {
      transform: none;
      transition-delay: 0s;
    }
  }
</style>
