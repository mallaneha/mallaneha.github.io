---
// Interactive widgets for posts. "LLMs by hand": <attention-lab>, <scale-lab>, <gpt-shape>, <serving-budget>
// (logic in src/scripts/explainers.ts). RAG posts: <abstain-lab>, <code-search>, <rule-of-two>, <poison-layers>,
// <attack-gap> (src/scripts/rag-explainers.ts). Posts place them in Markdown with static fallback content inside;
// src/scripts/effects.ts loads the logic only on pages that use one, and the fallback stays when JS is off.
---

<style is:global>
  /* Built to the ui-guides skill (.claude/skills/ui-guides). Results sit next to the control that changes them, values
     follow drags with no easing, discrete changes ease over --duration-state, 44px targets on touch. */
  attention-lab,
  scale-lab,
  gpt-shape,
  serving-budget,
  abstain-lab,
  code-search,
  rule-of-two,
  poison-layers,
  attack-gap {
    display: block;
    margin: var(--space-6) 0;
  }

  /* The card: a figure in the notebook. White like the page, one hairline, a header strip and a dotted
     footnote, so it reads as part of the post rather than a widget pasted on top. */
  .xp-fallback,
  .xp {
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-tile);
    background: var(--color-bg);
    font-size: var(--text-sm);
  }
  .xp-fallback {
    color: var(--color-body);
  }
  @media (min-width: 34rem) {
    .xp {
      padding: var(--space-4) var(--space-5);
    }
  }

  .xp-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    margin: calc(-1 * var(--space-4)) calc(-1 * var(--space-4)) var(--space-4);
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }
  @media (min-width: 34rem) {
    .xp-head {
      margin-inline: calc(-1 * var(--space-5));
      padding-inline: var(--space-5);
    }
  }
  .xp-heading {
    display: grid;
    gap: 2px;
    min-width: 0;
  }
  .xp-kicker {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-faint);
  }
  /* The same green dot as the availability line: this one is live. */
  .xp-kicker::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-status);
    box-shadow: 0 0 0 3px var(--color-status-ring);
  }
  .xp-title {
    margin: 0;
    font-weight: var(--weight-medium);
    color: var(--color-text);
    text-wrap: balance;
  }
  .xp-note {
    margin: var(--space-2) 0 0;
    font-size: var(--text-xs);
    color: var(--color-muted);
    text-wrap: pretty;
  }
  .xp-split .xp-note {
    text-align: center;
  }
  /* The last line of a card is its footnote: a dotted rule, like the separators in the drawers. */
  .xp > .xp-note:last-child {
    margin: var(--space-4) 0 0;
    padding-top: var(--space-3);
    border-top: 1px dotted var(--color-subtle);
  }

  .xp-controls {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }
  .xp-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: end;
  }
  .xp-row > .xp-field {
    flex: 1 1 14rem;
  }
  .xp-grid {
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
  }
  .xp-pair {
    grid-template-columns: 1fr 1fr;
  }

  /* Attention lab: the plot comes first on phones so it stays in view while you move the query. */
  .xp-split {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: 1fr;
  }
  @media (min-width: 34rem) {
    .xp-split {
      grid-template-columns: 1fr 13rem;
      align-items: start;
    }
    .xp-split > .xp-figure {
      order: 1;
    }
  }
  .xp-split > .xp-controls {
    margin-bottom: 0;
  }

  /* Fields */
  .xp-field {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-1) var(--space-2);
    align-items: center;
    min-width: 0;
  }
  .xp-field label {
    color: var(--color-body);
  }
  /* Slider: a thin track filled in the text color up to the value (--p, set in explainer-kit.ts), and a raised
     thumb. Monochrome like the rest of the page; the 44px input height is the touch target. */
  .xp-field input[type="range"] {
    --track: linear-gradient(
      to right,
      var(--color-text) var(--p, 50%),
      var(--color-border) var(--p, 50%)
    );
    grid-column: 1 / -1;
    grid-row: 2;
    width: 100%;
    min-height: 44px;
    margin: 0;
    background: transparent;
    cursor: pointer;
    appearance: none;
    -webkit-appearance: none;
  }
  .xp-field input[type="range"]::-webkit-slider-runnable-track {
    height: 4px;
    border-radius: 2px;
    background: var(--track);
  }
  .xp-field input[type="range"]::-moz-range-track {
    height: 4px;
    border-radius: 2px;
    background: var(--track);
  }
  .xp-field input[type="range"]::-webkit-slider-thumb {
    width: 18px;
    height: 18px;
    margin-top: -7px;
    border: 0;
    border-radius: 50%;
    background: var(--color-raised);
    box-shadow:
      var(--shadow-raised),
      inset 0 0 0 5px var(--color-text);
    transition: transform var(--transition-press);
    -webkit-appearance: none;
  }
  .xp-field input[type="range"]::-moz-range-thumb {
    width: 18px;
    height: 18px;
    border: 0;
    border-radius: 50%;
    background: var(--color-raised);
    box-shadow:
      var(--shadow-raised),
      inset 0 0 0 5px var(--color-text);
    transition: transform var(--transition-press);
  }
  .xp-field input[type="range"]:active::-webkit-slider-thumb {
    transform: scale(1.12);
  }
  .xp-field input[type="range"]:active::-moz-range-thumb {
    transform: scale(1.12);
  }
  .xp-field input[type="range"]:focus-visible {
    outline: none;
  }
  .xp-field input[type="range"]:focus-visible::-webkit-slider-thumb {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .xp-field input[type="range"]:focus-visible::-moz-range-thumb {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .xp-field output {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums slashed-zero;
    color: var(--color-text);
  }
  .xp-field-number,
  .xp-field-select {
    grid-template-columns: 1fr;
  }
  /* Selects lose the system chrome; a drawn chevron sits where the native arrow was. */
  .xp-field-select {
    position: relative;
  }
  .xp-field select {
    padding-right: var(--space-8);
    appearance: none;
    -webkit-appearance: none;
    cursor: pointer;
  }
  .xp-field-select::after {
    content: "";
    position: absolute;
    right: var(--space-4);
    bottom: 19px;
    width: 0.4rem;
    height: 0.4rem;
    border-right: 1.5px solid var(--color-muted);
    border-bottom: 1.5px solid var(--color-muted);
    transform: rotate(45deg);
    pointer-events: none;
  }
  .xp-field input[type="text"],
  .xp-field select {
    width: 100%;
    min-height: 44px;
    padding: 0 var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-row);
    background: var(--color-bg);
    color: var(--color-text);
    font: inherit;
    font-variant-numeric: tabular-nums;
    transition: border-color var(--transition);
  }
  .xp-field input[type="text"]:focus-visible,
  .xp-field select:focus-visible {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px var(--color-selection);
  }
  .xp-field input[type="text"]:hover,
  .xp-field select:hover {
    border-color: var(--color-muted);
  }
  .xp-field input[aria-invalid="true"] {
    border-color: var(--chart-alert);
  }
  .xp-hint {
    font-size: var(--text-xs);
    color: var(--chart-alert);
  }
  .xp-field.is-invalid output {
    color: var(--chart-alert);
  }

  /* Segmented control (radio buttons). 2px inset, so the inner radius is the outer one minus 2px. */
  .xp-choice {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  .xp-choice legend {
    margin-bottom: var(--space-1);
    padding: 0;
    color: var(--color-body);
  }
  /* A sunken track with the selected segment raised out of it. */
  .xp-tabs {
    display: flex;
    gap: 2px;
    padding: 2px;
    border-radius: var(--radius-row);
    background: var(--color-surface);
    box-shadow: inset 0 0 0 1px var(--color-border);
  }
  .xp-tabs label {
    position: relative;
    flex: 1;
    display: grid;
    place-items: center;
    min-height: 36px;
    border-radius: var(--radius);
    color: var(--color-muted);
    cursor: pointer;
    transition:
      background-color var(--transition),
      color var(--transition);
  }
  .xp-tabs input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }
  @media (hover: hover) and (pointer: fine) {
    .xp-tabs label:hover {
      color: var(--color-text);
    }
  }
  /* Labels and their selected copies share padding, so a long label wraps the same way in both. */
  .xp-tabs label,
  .xp-tabs-active span {
    flex: 1 1 0;
    min-width: 0;
    padding: 0 var(--space-1);
    text-align: center;
    line-height: var(--leading-tight);
  }
  /* The selected clip assumes equal segments, so on phones long labels shrink rather than widen theirs. */
  @media (max-width: 30rem) {
    .xp-tabs label,
    .xp-tabs-active span {
      padding: 0;
      font-size: var(--text-xs);
    }
  }
  /* The selected look: a copy of the labels on top, clipped to the checked one (--i of --n). Moving the clip
     carries the background and the text color across together, so there's no crossfade between two labels. */
  .xp-tabs {
    position: relative;
  }
  .xp-tabs-active {
    --w: calc((100% - (var(--n) - 1) * 2px) / var(--n) + 2px);
    position: absolute;
    inset: 2px;
    display: flex;
    gap: 2px;
    pointer-events: none;
    clip-path: inset(
      0 calc((var(--n) - 1 - var(--i)) * var(--w)) 0 calc(var(--i) * var(--w))
        round var(--radius)
    );
  }
  .xp-tabs-active span {
    flex: 1;
    display: grid;
    place-items: center;
    border-radius: var(--radius);
    background: var(--color-raised);
    color: var(--color-text);
    font-weight: var(--weight-medium);
  }
  /* The clip would cut a shadow off, so the raised edge is drawn on the track: a ring that follows --i. */
  .xp-tabs::before {
    content: "";
    position: absolute;
    top: 2px;
    bottom: 2px;
    left: 2px;
    width: calc((100% - 4px - (var(--n) - 1) * 2px) / var(--n));
    transform: translateX(calc(var(--i) * (100% + 2px)));
    border-radius: var(--radius);
    box-shadow: var(--shadow-raised);
    pointer-events: none;
  }
  .xp-tabs label:has(input:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 1px;
  }

  .xp-check {
    display: inline-flex;
    gap: var(--space-2);
    align-items: center;
    min-height: 44px;
    color: var(--color-text);
    cursor: pointer;
  }
  /* Checkbox drawn to match the slider: a hairline square that fills with the text color, check cut out. */
  .xp-check input {
    flex: none;
    position: relative;
    display: grid;
    place-items: center;
    width: 1rem;
    height: 1rem;
    margin: 0;
    border: 1px solid var(--color-subtle);
    border-radius: var(--radius);
    background: var(--color-bg);
    cursor: pointer;
    appearance: none;
    -webkit-appearance: none;
    transition:
      background-color var(--transition),
      border-color var(--transition);
  }
  .xp-check input::before {
    content: "";
    width: 0.6rem;
    height: 0.6rem;
    background: var(--color-bg);
    clip-path: polygon(14% 44%, 0 59%, 40% 96%, 100% 22%, 85% 8%, 39% 66%);
    opacity: 0;
    transform: scale(0.6);
    transition:
      opacity 120ms var(--ease-out),
      transform 120ms var(--ease-out);
  }
  .xp-check input:checked {
    border-color: var(--color-text);
    background: var(--color-text);
  }
  .xp-check input:checked::before {
    opacity: 1;
    transform: none;
  }
  .xp-check input:disabled {
    opacity: 0.45;
    cursor: default;
  }
  .xp-check input:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  @media (hover: hover) and (pointer: fine) {
    .xp-check:hover input:not(:checked, :disabled) {
      border-color: var(--color-muted);
    }
  }

  .xp-button,
  .xp-ghost {
    min-height: 44px;
    padding: 0 var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-row);
    background: var(--color-bg);
    color: var(--color-text);
    font: inherit;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition:
      background-color var(--transition),
      color var(--transition),
      transform var(--transition-press);
  }
  .xp-button {
    align-self: flex-end;
  }
  @media (hover: hover) and (pointer: fine) {
    .xp-button:hover {
      background: var(--color-hover);
    }
  }
  /* A secondary action: quiet until you look at it. */
  .xp-ghost {
    position: relative;
    min-height: 32px;
    padding: 0 var(--space-2);
    border: 0;
    background: transparent;
    color: var(--color-muted);
    font-size: var(--text-xs);
  }
  .xp-ghost::before {
    /* 44px tall hit area without a bigger-looking button */
    content: "";
    position: absolute;
    inset: -6px -4px;
  }
  @media (hover: hover) and (pointer: fine) {
    .xp-ghost:hover {
      background: var(--color-hover);
      color: var(--color-text);
    }
  }
  .xp-button:active,
  .xp-ghost:active {
    transform: scale(0.97);
  }

  /* Progressive disclosure for the serving budget's raw numbers. */
  .xp-more {
    margin-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }
  .xp-more summary {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    color: var(--color-body);
    cursor: pointer;
    list-style: none;
  }
  .xp-more summary::-webkit-details-marker {
    display: none;
  }
  .xp-more summary::before {
    content: "";
    width: 0.4rem;
    height: 0.4rem;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(-45deg);
    transition: transform var(--transition);
  }
  .xp-more[open] summary::before {
    transform: rotate(45deg);
  }
  @media (hover: hover) and (pointer: fine) {
    .xp-more summary:hover {
      color: var(--color-text);
    }
  }
  .xp-more > .xp-controls {
    margin: var(--space-2) 0 0;
  }

  /* Tables: shadows at the edges show when there's more to scroll to. */
  .xp-scroll {
    overflow-x: auto;
    margin: var(--space-4) 0;
    background:
      linear-gradient(to right, var(--color-bg) 30%, transparent) left / 2rem
        100% no-repeat local,
      linear-gradient(to left, var(--color-bg) 30%, transparent) right / 2rem
        100% no-repeat local,
      radial-gradient(
          farthest-side at 0 50%,
          color-mix(in srgb, var(--color-text) 14%, transparent),
          transparent
        )
        left / 0.75rem 100% no-repeat scroll,
      radial-gradient(
          farthest-side at 100% 50%,
          color-mix(in srgb, var(--color-text) 14%, transparent),
          transparent
        )
        right / 0.75rem 100% no-repeat scroll;
  }
  .xp-table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums slashed-zero;
  }
  .xp-table caption {
    margin-bottom: var(--space-2);
    text-align: left;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--color-body);
    text-wrap: pretty;
  }
  .xp-table th,
  .xp-table td {
    padding: var(--space-1) var(--space-2);
    border-bottom: 1px solid var(--color-border);
    text-align: right;
    white-space: nowrap;
  }
  .xp-table th {
    font-weight: var(--weight-medium);
    color: var(--color-text);
  }
  /* Column heads in the sans face, quieter than the numbers under them (and narrower, so tables fit). */
  .xp-table thead th {
    font-family: var(--font-sans);
    font-weight: var(--weight-normal);
    color: var(--color-muted);
    border-bottom-color: var(--color-subtle);
  }
  .xp-table th[scope="row"],
  .xp-table thead th:first-child {
    text-align: left;
  }
  /* Long row names wrap instead of pushing the numbers off-screen. */
  .xp-table th[scope="row"] {
    white-space: normal;
    min-width: 6ch;
  }
  .xp-table td {
    color: var(--color-body);
  }
  .xp-table tr.is-masked td,
  .xp-table tr.is-masked th {
    color: var(--color-faint);
  }
  .xp-table tr.is-selected th,
  .xp-table tr.is-selected td {
    background: var(--color-surface);
  }
  /* Phones: drop the key-vector column (the plot shows it) so the scores fit without scrolling. */
  @media (max-width: 30rem) {
    .xp-table th,
    .xp-table td {
      padding-inline: var(--space-1);
    }
    .xp-wide-only {
      display: none;
    }
  }

  .xp-weight {
    min-width: 3.5rem;
  }
  .xp-weight > span:first-child {
    display: block;
  }
  .xp-bar {
    display: block;
    height: 4px;
    margin-top: 2px;
    border-radius: 2px;
    background: var(--color-border);
    overflow: hidden;
  }
  .xp-bar-fill {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--chart-main);
    transform: scaleX(0);
    transform-origin: left;
  }

  .xp-summary {
    margin: var(--space-3) 0;
    color: var(--color-text);
    text-wrap: pretty;
  }
  .xp-big {
    margin: 0 0 var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    font-variant-numeric: tabular-nums;
    color: var(--color-text);
  }

  .xp-stack {
    position: relative;
    height: 8px;
    margin: var(--space-4) 0 var(--space-3);
    border-radius: 4px;
    background: var(--color-border);
    overflow: hidden;
  }
  .xp-stack.is-over {
    outline: 2px dashed var(--chart-alert);
    outline-offset: 2px;
  }
  .xp-seg,
  .xp-swatch {
    display: block;
    background: var(--color-border);
  }
  /* Each segment spans the track; stackBar() in explainer-kit.ts moves and scales it into place. */
  .xp-seg {
    position: absolute;
    inset: 0;
    transform: scaleX(0);
    transform-origin: left;
  }
  .xp-swatch {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }
  .k-main {
    background: var(--chart-main);
  }
  .k-main-soft {
    background: var(--chart-main-soft);
  }
  .k-alert {
    background: var(--chart-alert);
  }
  .k-alert-soft {
    background: var(--chart-alert-soft);
  }
  .k-neutral {
    background: var(--chart-neutral);
  }
  .k-other {
    background: var(--chart-other);
  }
  .k-other-soft {
    background: var(--chart-other-soft);
  }
  .xp-seg.k-free {
    background: transparent;
  }
  .xp-swatch.k-free {
    border: 1px solid var(--color-subtle);
  }

  .xp-legend {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 0 var(--space-4);
    margin: 0 0 var(--space-3);
    padding: 0;
    list-style: none;
    color: var(--color-body);
    font-variant-numeric: tabular-nums;
  }
  .xp-legend li {
    display: flex;
    gap: var(--space-2);
    align-items: center;
  }

  /* Facts: label and value side by side when there's room, so the eye can scan one column of numbers. */
  .xp-facts {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0 var(--space-4);
    margin: var(--space-3) 0 0;
  }
  @media (min-width: 34rem) {
    .xp-facts {
      grid-template-columns: max-content 1fr;
    }
    .xp-facts dt,
    .xp-facts dd {
      padding: var(--space-1) 0;
      border-bottom: 1px solid var(--color-border);
    }
  }
  .xp-facts dt {
    color: var(--color-body);
  }
  .xp-facts dd {
    margin: 0 0 var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
    color: var(--color-text);
    overflow-wrap: anywhere;
  }
  @media (min-width: 34rem) {
    .xp-facts dd {
      margin: 0;
    }
  }

  /* Plots */
  .xp-figure {
    margin: var(--space-3) 0;
  }
  .xp-split > .xp-figure {
    margin: 0;
  }
  .xp-plot-wrap {
    position: relative;
    max-width: 16rem;
    margin: 0 auto;
  }
  .xp-plot,
  .xp-chart {
    display: block;
    width: 100%;
    height: auto;
    max-width: 100%;
    user-select: none;
    -webkit-user-select: none;
  }
  .xp-plot {
    cursor: crosshair;
  }
  .xp-chart {
