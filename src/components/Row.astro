---
// One list row: icon tile (optional), name, one muted line. It opens a drawer, links somewhere,
// copies a value, or is static. Modeled on the rows at ch.sh.
import Icon from "./Icon.astro";
import type { IconName } from "../data/icons";

interface Props {
  icon?: IconName; // leave out (with no logo) for a row without a tile
  logo?: string; // image under public/logos/, shown instead of the icon
  logoSize?: number; // px, default 24
  logoFull?: boolean; // the logo is a filled square: it covers the whole tile
  logoAlt?: string; // debug only: alternative logo the ?debug panel can swap in (see scripts/debug.ts)
  logoAltSize?: number; // px of logoAlt inside the tile, default 24
  logoAltFull?: boolean; // logoAlt is a filled square: it covers the whole tile
  glyph?: string; // a letter (e.g. Nepali क) shown in the tile instead of the icon
  name: string;
  desc?: string;
  meta?: string;
  href?: string;
  drawer?: string; // id of a <Drawer> to open
  copy?: string; // value to copy to the clipboard
  copyLabel?: string; // toast text after copying
  copyEmail?: boolean; // `copy` is a spelled-out email ("name[at]gmail[dot]com"): copy the real address
  openIcon?: boolean; // always show the open-link arrow at the end
}

const {
  icon,
  logo,
  logoSize = 24,
  logoFull = false,
  logoAlt,
  logoAltSize = 24,
  logoAltFull = false,
  glyph,
  name,
  desc,
  meta,
  href,
  drawer,
  copy,
  copyLabel,
  copyEmail,
  openIcon,
} = Astro.props;
const external = Boolean(href?.startsWith("http"));

let Tag: "button" | "a" | "div" = "div";
let attrs: Record<string, string | boolean | undefined> = {};
if (drawer) {
  Tag = "button";
  attrs = {
    type: "button",
    "data-drawer-open": drawer,
    "aria-haspopup": "dialog",
    "aria-controls": drawer,
  };
} else if (copy) {
  Tag = "button";
  attrs = {
    type: "button",
    "data-copy": copy,
    "data-copy-email": copyEmail,
    "data-copy-label": copyLabel ?? "Copied",
    "data-copy-fallback": href,
  };
} else if (href) {
  Tag = "a";
  attrs = external
    ? { href, target: "_blank", rel: "noopener noreferrer" }
    : { href };
}
---

<li>
  <Tag
    class:list={[
      "row",
      { static: Tag === "div", "has-tile": Boolean(logo || glyph || icon) },
    ]}
    {...attrs}
  >
    {(logo || glyph || icon) && (
      <span class:list={["tile", { logo, full: logo && logoFull }]}>
        {logo ? (
          <img
            src={logo}
            alt=""
            width={logoFull ? 40 : logoSize}
            height={logoFull ? 40 : logoSize}
            loading="lazy"
            data-logo-alt={logoAlt}
            data-logo-alt-size={logoAlt && (logoAltFull ? 40 : logoAltSize)}
            data-logo-alt-full={logoAlt && logoAltFull}
          />
        ) : glyph ? (
          <span class="glyph" lang="ne" aria-hidden="true">
            {glyph}
          </span>
        ) : (
          icon && <Icon name={icon} />
        )}
      </span>
    )}
    <span class="text">
      <span class="name">{name}</span>
      {desc && <span class="desc">{desc}</span>}
    </span>
    {meta && <span class="meta">{meta}</span>}
    {openIcon ? (
      <Icon name="arrowUpRight" size={14} class="arrow open" />
    ) : (
      external && !meta && <Icon name="arrowUpRight" size={14} class="arrow" />
    )}
  </Tag>
</li>

<style>
  li {
    list-style: none;
  }
  .row {
    /* --row-inset: how far the hover background reaches past the content on each side.
       The row bleeds out by the same amount, so text stays on the column edge. */
    --row-inset: var(--space-3);
    --row-radius: var(--radius-row);
    display: flex;
    align-items: center;
    gap: var(--space-4);
    width: calc(100% + 2 * var(--row-inset));
    margin: 0 calc(-1 * var(--row-inset));
    padding: var(--space-1) var(--space-4) var(--space-1) var(--row-inset);
    border: 0;
    border-radius: var(--row-radius);
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: var(--text-sm);
    line-height: 1.25rem;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color var(--transition),
      transform var(--transition-press);
    -webkit-tap-highlight-color: transparent;
  }
  /* Rows with a tile: the same 4px inset on the tile's top, bottom and left (the vertical
     padding, so row height and the gaps between rows don't change), and an outer corner
     of tile radius + inset, so the hover background and focus ring stay concentric with
     the tile (visual-concentric-radius). The right side keeps the usual bleed so the
     text column is as wide as before. The tile sits at the top: when the text wraps
     (a long school name), it keeps the same 4px inset instead of floating mid-row. */
  .row.has-tile {
    --row-inset: var(--space-1);
    --row-radius: calc(var(--radius-tile) + var(--row-inset));
    align-items: flex-start;
    width: calc(100% + var(--row-inset) + var(--space-3));
    margin: 0 calc(-1 * var(--space-3)) 0 calc(-1 * var(--row-inset));
    padding: var(--row-inset) var(--space-4) var(--row-inset) var(--row-inset);
  }
  .row.has-tile .meta,
  .row.has-tile :global(.arrow:not(.open)) {
    align-self: center;
  }
  /* Keep the focus ring on the row's own radius, not the global :focus-visible 4px. */
  .row:focus-visible {
    border-radius: var(--row-radius);
  }
  @media (hover: hover) and (pointer: fine) {
    .row:not(.static):hover {
      background: var(--color-hover);
    }
    .row:not(.static):hover .tile {
      background: var(--color-surface-hover);
    }
    .row:not(.static):hover .tile.logo {
      background: var(--color-logo-tile);
    }
    .row:not(.static):hover .tile :global(svg),
    .row:not(.static):hover .tile img,
    .row:not(.static):hover .tile .glyph {
      transform: scale(1.05);
    }
  }
  .row:not(.static):active {
    transform: scale(0.98);
  }
  .static {
    cursor: default;
  }
  .tile {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-tile);
    background: var(--color-surface);
    transition: background-color var(--transition);
  }
  .tile.logo {
    border: 1px solid var(--color-border);
    background: var(--color-logo-tile);
  }
  /* A filled square logo (CMU) is the tile itself. */
  .tile.full {
    overflow: hidden;
    border: 0;
  }
  .tile.full img {
    width: 100%;
    height: 100%;
    border-radius: 0;
  }
  .tile img {
    border-radius: var(--radius-logo);
    /* Multiply drops a JPEG's white box into the tile. */
    mix-blend-mode: multiply;
  }
  .glyph {
    font-family: var(--font-devanagari);
    font-size: var(--text-sm); /* about the size of the 16px icons */
    line-height: 1;
    font-weight: var(--weight-medium);
  }
  .tile :global(svg),
  .tile img,
  .tile .glyph {
    transition: transform var(--transition);
  }
  .text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .name {
    font-weight: var(--weight-medium);
    overflow-wrap: anywhere; /* long values (an email address) in a narrow column */
  }
  .desc {
    color: var(--color-muted);
  }
  .meta {
    margin-left: auto;
    flex-shrink: 0;
    color: var(--color-muted);
  }
  .row :global(.arrow) {
    margin-left: auto;
    flex-shrink: 0;
    color: var(--color-muted);
    transition:
      opacity var(--transition),
      transform var(--transition);
  }
  .row :global(.arrow.open) {
    align-self: flex-start;
    margin-top: 0.1875rem;
  }
  @media (hover: hover) and (min-width: 48rem) {
    .row :global(.arrow:not(.open)) {
      opacity: 0;
    }
    .row:hover :global(.arrow) {
      opacity: 1;
    }
    .row:hover :global(.arrow.open) {
      transform: translate(1px, -1px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .row:not(.static):active,
    .row:not(.static):hover .tile :global(svg),
    .row:not(.static):hover .tile img,
    .row:not(.static):hover .tile .glyph,
    .row:hover :global(.arrow.open) {
      transform: none;
    }
  }
</style>
