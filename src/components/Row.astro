---
// One list row: icon tile (optional), name, one muted line. It opens a drawer, links somewhere,
// copies a value, or is static. Modeled on the rows at ch.sh.
import Icon from "./Icon.astro";
import type { IconName } from "../data/icons";

interface Props {
  icon?: IconName; // leave out (with no logo) for a row without a tile
  logo?: string; // image under public/logos/, shown instead of the icon
  glyph?: string; // a letter (e.g. Nepali क) shown in the tile instead of the icon
  name: string;
  desc?: string;
  meta?: string;
  href?: string;
  drawer?: string; // id of a <Drawer> to open
  copy?: string; // value to copy to the clipboard
  copyLabel?: string; // toast text after copying
  openIcon?: boolean; // always show the open-link arrow at the end
}

const {
  icon,
  logo,
  glyph,
  name,
  desc,
  meta,
  href,
  drawer,
  copy,
  copyLabel,
  openIcon,
} = Astro.props;
const external = Boolean(href?.startsWith("http"));

let Tag: "button" | "a" | "div" = "div";
let attrs: Record<string, string | boolean | undefined> = {};
if (drawer) {
  Tag = "button";
  attrs = {
    type: "button",
    "data-drawer-open": drawer,
    "aria-haspopup": "dialog",
    "aria-controls": drawer,
  };
} else if (copy) {
  Tag = "button";
  attrs = {
    type: "button",
    "data-copy": copy,
    "data-copy-label": copyLabel ?? "Copied",
    "data-copy-fallback": href,
  };
} else if (href) {
  Tag = "a";
  attrs = external
    ? { href, target: "_blank", rel: "noopener noreferrer" }
    : { href };
}
---

<li>
  <Tag class:list={["row", { static: Tag === "div" }]} {...attrs}>
    {(logo || glyph || icon) && (
      <span class:list={["tile", { logo }]}>
        {logo ? (
          <img src={logo} alt="" width="24" height="24" loading="lazy" />
        ) : glyph ? (
          <span class="glyph" lang="ne" aria-hidden="true">
            {glyph}
          </span>
        ) : (
          icon && <Icon name={icon} />
        )}
      </span>
    )}
    <span class="text">
      <span class="name">{name}</span>
      {desc && <span class="desc">{desc}</span>}
    </span>
    {meta && <span class="meta">{meta}</span>}
    {openIcon ? (
      <Icon name="arrowUpRight" size={14} class="arrow open" />
    ) : (
      external && !meta && <Icon name="arrowUpRight" size={14} class="arrow" />
    )}
  </Tag>
</li>

<style>
  li {
    list-style: none;
  }
  .row {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    width: calc(100% + 2 * var(--space-3));
    margin: 0 calc(-1 * var(--space-3));
    padding: var(--space-1) var(--space-4) var(--space-1) var(--space-3);
    border: 0;
    border-radius: var(--radius-row);
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: var(--text-sm);
    line-height: 1.25rem;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color var(--transition),
      transform var(--transition);
    -webkit-tap-highlight-color: transparent;
  }
  .row:not(.static):hover {
    background: var(--color-hover);
  }
  .row:not(.static):active {
    transform: scale(0.98);
  }
  .static {
    cursor: default;
  }
  .tile {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-tile);
    background: var(--color-surface);
    transition: background-color var(--transition);
  }
  .tile.logo {
    border: 1px solid var(--color-border);
    background: var(--color-logo-tile);
  }
  .tile img {
    border-radius: var(--radius-logo);
    /* Multiply drops a JPEG's white box into the tile. */
    mix-blend-mode: multiply;
  }
  .glyph {
    font-family: var(--font-devanagari);
    font-size: 1.125rem;
    line-height: 1;
    font-weight: var(--weight-medium);
  }
  .tile :global(svg),
  .tile img,
  .tile .glyph {
    transition: transform var(--transition);
  }
  .row:not(.static):hover .tile {
    background: var(--color-surface-hover);
  }
  .row:not(.static):hover .tile.logo {
    background: var(--color-logo-tile);
  }
  .row:not(.static):hover .tile :global(svg),
  .row:not(.static):hover .tile img,
  .row:not(.static):hover .tile .glyph {
    transform: scale(1.1);
  }
  .text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .name {
    font-weight: var(--weight-medium);
    overflow-wrap: anywhere; /* long values (an email address) in a narrow column */
  }
  .desc {
    color: var(--color-muted);
  }
  .meta {
    margin-left: auto;
    flex-shrink: 0;
    color: var(--color-muted);
  }
  .row :global(.arrow) {
    margin-left: auto;
    flex-shrink: 0;
    color: var(--color-muted);
    transition:
      opacity var(--transition),
      transform var(--transition);
  }
  .row :global(.arrow.open) {
    align-self: flex-start;
    margin-top: 0.1875rem;
  }
  @media (hover: hover) and (min-width: 48rem) {
    .row :global(.arrow:not(.open)) {
      opacity: 0;
    }
    .row:hover :global(.arrow) {
      opacity: 1;
    }
    .row:hover :global(.arrow.open) {
      transform: translate(1px, -1px);
    }
  }
</style>
