---
// Bottom-sheet drawer (native <dialog>). Behavior lives in src/scripts/drawer.ts.
// The slot is a case study rendered from Markdown; see docs/CONTENT.md for the format.
import Icon from "./Icon.astro";
import type { IconName } from "../data/icons";

interface Props {
  id: string;
  icon: IconName;
  logo?: string; // image under public/logos/, shown instead of the icon
  name: string;
  desc: string;
  href?: string;
  hrefLabel?: string;
}

const { id, icon, logo, name, desc, href, hrefLabel = "Visit" } = Astro.props;
const external = Boolean(href?.startsWith("http"));
const linkAttrs = external
  ? { href, target: "_blank", rel: "noopener noreferrer" }
  : { href };
---

<dialog id={id} class="drawer" data-drawer aria-labelledby={`${id}-title`}>
  <div class="head" data-drawer-handle>
    <div class="head-inner">
      <span class:list={["title-icon", { logo }]}>
        {logo ? (
          <img src={logo} alt="" width="18" height="18" loading="lazy" />
        ) : (
          <Icon name={icon} />
        )}
      </span>
      <p id={`${id}-title`} class="title">
        <span class="name">{name}</span>
        <span class="dot" aria-hidden="true">
          ·
        </span>
        <span class:list={["sub", { swap: href }]}>
          <span class="desc">{desc}</span>
          {href && (
            <a class="pill pill-inline" {...linkAttrs} tabindex="-1">
              {hrefLabel}
              <Icon name="arrowUpRight" size={12} />
            </a>
          )}
        </span>
      </p>
      {href && (
        <a class="pill pill-wide" {...linkAttrs}>
          {hrefLabel}
          <Icon name="arrowUpRight" size={12} />
        </a>
      )}
    </div>
    <button type="button" class="close" data-drawer-close aria-label="Close">
      <Icon name="x" />
    </button>
  </div>
  <div class="body">
    <div class="case">
      <slot />
    </div>
  </div>
</dialog>

<style>
  .drawer {
    position: fixed;
    inset: auto 0 0 0;
    width: 100%;
    max-width: none;
    max-height: 85vh;
    max-height: 85dvh;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: var(--radius-sheet) var(--radius-sheet) 0 0;
    background: var(--color-bg);
    color: var(--color-text);
    flex-direction: column;
    overflow: hidden;
    box-shadow: var(--shadow-sheet);
    transform: translateY(100%);
    transition: transform var(--drawer-in) var(--ease-drawer);
  }
  .drawer:focus-visible {
    outline: none;
  }
  .drawer[open] {
    display: flex;
  }
  .drawer:global(.is-visible) {
    transform: translateY(0);
  }
  .drawer:global(.is-closing) {
    transition-duration: var(--drawer-out);
  }
  .drawer:global(.is-dragging) {
    transition: none;
  }
  .drawer::backdrop {
    background: var(--color-overlay);
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
    opacity: 0;
    transition: opacity var(--drawer-in) ease;
  }
  .drawer:global(.is-visible)::backdrop {
    opacity: 1;
  }

  .head {
    position: relative;
    flex-shrink: 0;
    padding: var(--space-5) var(--space-5) var(--space-4);
    border-bottom: 1px solid var(--color-border);
    touch-action: none;
    cursor: grab;
  }
  .head::before {
    /* drag handle */
    content: "";
    position: absolute;
    top: var(--space-2);
    left: 50%;
    width: 2.25rem;
    height: 0.25rem;
    margin-left: -1.125rem;
    border-radius: 999px;
    background: var(--color-border);
  }
  .head-inner {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    max-width: var(--drawer-width);
    margin: 0 auto;
    padding-right: var(--space-8);
  }
  .title-icon {
    display: flex;
    flex-shrink: 0;
  }
  /* A light tile behind logos so they read in dark mode (and multiply has white to blend into). */
  .title-icon.logo {
    padding: 2px;
    border-radius: var(--radius-logo);
    background: var(--color-logo-tile);
  }
  .title-icon img {
    border-radius: var(--radius-logo);
    /* Multiply drops a JPEG's white box into the tile. */
    mix-blend-mode: multiply;
  }
  .title {
    flex: 1;
    display: flex;
    align-items: center;
    min-width: 0;
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.25rem;
    font-weight: var(--weight-semibold);
    white-space: nowrap;
  }
  .name,
  .dot {
    flex-shrink: 0;
  }
  .dot {
    margin: 0 var(--space-1);
    color: var(--color-subtle);
  }
  .sub {
    position: relative;
    min-width: 4rem;
    font-weight: var(--weight-medium);
    color: var(--color-muted);
  }
  .desc {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.125rem;
    flex-shrink: 0;
    padding: 0.375rem var(--space-3);
    border-radius: 999px;
    background: var(--color-surface-hover);
    color: var(--color-muted);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    line-height: 1;
    text-decoration: none;
    transition:
      background-color var(--transition),
      color var(--transition);
  }
  .pill:hover {
    color: var(--color-text);
  }
  .pill-inline {
    display: none;
  }
  .close {
    position: absolute;
    top: 50%;
    right: var(--space-5);
    transform: translateY(-50%);
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 0;
    border-radius: var(--radius-row);
    background: transparent;
    color: var(--color-muted);
    cursor: pointer;
    transition:
      background-color var(--transition),
      color var(--transition);
  }
  .close:hover {
    background: var(--color-hover);
    color: var(--color-text);
  }

  /* Phones: description and Visit pill take turns, like ch.sh. */
  @media (max-width: 47.99rem) {
    .pill-wide {
      display: none;
    }
    .swap .pill-inline {
      display: inline-flex;
      position: absolute;
      left: 0;
      top: 50%;
      padding: 0.125rem var(--space-2);
      transform: translateY(-50%);
      opacity: 0;
      pointer-events: none;
      animation: swap-in 6s infinite;
    }
    .swap .desc {
      animation: swap-out 6s infinite;
    }
  }
  @keyframes swap-out {
    0%,
    42% {
      opacity: 1;
    }
    50%,
    92% {
      opacity: 0;
    }
    100% {
      opacity: 1;
    }
  }
  @keyframes swap-in {
    0%,
    42% {
      opacity: 0;
      pointer-events: none;
    }
    50%,
    92% {
      opacity: 1;
      pointer-events: auto;
    }
    100% {
      opacity: 0;
    }
  }

  .body {
    flex: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0 var(--space-5);
  }
  .case {
    max-width: var(--drawer-text);
    margin: 0 auto;
    padding: var(--space-12) 0 var(--space-16);
    font-size: var(--text-sm);
    line-height: 1.25rem;
    color: var(--color-body);
  }

  /* Case-study Markdown. ## = section, ### = small label, > = footnote. */
  .case :global(h2) {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin: 0 0 var(--space-4);
    font-size: var(--text-sm);
    font-weight: var(--weight-normal);
    color: var(--color-faint);
  }
  .case :global(h2)::after {
    content: "";
    flex: 1;
    border-top: 1px dotted var(--color-subtle);
  }
  .case :global(h2:not(:first-child)) {
    position: relative;
    margin-top: calc(var(--space-8) * 2 + 1.25rem);
  }
  .case :global(h2:not(:first-child))::before {
    content: "···";
    position: absolute;
    left: 0;
    right: 0;
    top: calc(-1 * (var(--space-8) + 1.25rem));
    text-align: center;
    color: var(--color-faint);
    user-select: none;
  }
  .case :global(h3) {
    margin: var(--space-6) 0 var(--space-1);
    font-size: var(--text-xs);
    line-height: 1rem;
    font-weight: var(--weight-normal);
    color: var(--color-faint);
  }
  .case :global(h2 + h3) {
    margin-top: var(--space-2);
  }
  .case :global(p) {
    margin: 0 0 var(--space-4);
  }
  .case :global(ul) {
    margin: 0 0 var(--space-4);
    padding-left: 1.1em;
  }
  .case :global(li + li) {
    margin-top: var(--space-1);
  }
  .case :global(a) {
    font-weight: var(--weight-medium);
    text-decoration-style: dotted;
    text-decoration-color: var(--color-subtle);
    text-underline-offset: 4px;
  }
  .case :global(blockquote) {
    margin: var(--space-2) 0 var(--space-4);
    padding: var(--space-4) 0 0;
    border-top: 1px dotted var(--color-subtle);
    font-size: var(--text-xs);
    line-height: 1rem;
    color: var(--color-faint);
  }
  .case :global(blockquote p) {
    margin: 0;
  }
  .case :global(.stats) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(6rem, 1fr));
    gap: var(--space-3);
    margin: var(--space-6) 0;
  }
  .case :global(.stats > div) {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-tile);
    background: var(--color-surface);
  }
  .case :global(.stats strong) {
    font-size: var(--text-lg);
    line-height: 1.5rem;
    font-weight: var(--weight-semibold);
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
  }
  .case :global(.stats span) {
    font-size: var(--text-xs);
    line-height: 1rem;
    color: var(--color-muted);
  }
  .case :global(.flow) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-6);
    margin: var(--space-6) 0;
    padding: 0;
    list-style: none;
  }
  .case :global(.flow li) {
    position: relative;
    margin: 0;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-row);
    font-size: var(--text-xs);
    line-height: 1rem;
    color: var(--color-text);
  }
  .case :global(.flow li:not(:last-child))::after {
    content: "→";
    position: absolute;
    right: calc(-1 * var(--space-6));
    width: var(--space-6);
    top: 50%;
    transform: translateY(-50%);
    text-align: center;
    color: var(--color-faint);
  }

  @media (prefers-reduced-motion: reduce) {
    .drawer,
    .drawer::backdrop {
      transition: none;
    }
    .swap .desc,
    .swap .pill-inline {
      animation: none;
    }
  }
</style>
